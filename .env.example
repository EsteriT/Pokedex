# Copy this to .env.local. Never commit the filled file.
# Local Google OAuth app (backend only; never included in the website).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Leave these blank until the local stack runs. Get local values from
# npm run backend:status, then set them to enable cloud mode in local builds.
POKEDEX_SUPABASE_URL=
POKEDEX_SUPABASE_PUBLISHABLE_KEY=
