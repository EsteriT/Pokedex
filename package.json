{
  "name": "pokedex",
  "version": "1.0.0",
  "private": true,
  "description": "A Pokémon binder workshop with private cloud saving, customization, collection tools and portable backups.",
  "scripts": {
    "capacity:plan": "node scripts/capacity-plan.cjs",
    "test:capacity": "node scripts/check-capacity-plan.cjs",
    "dev": "python scripts/serve-local.py",
    "test:server": "python scripts/check-local-server.py",
    "test:usage": "node scripts/check-usage-gateway.cjs",
    "test:usage:live": "node scripts/check-usage-live.cjs",
    "test:usage:edge": "node scripts/check-usage-live.cjs --edge",
    "test:usage:load": "node scripts/check-usage-live.cjs --edge --load",
    "build": "node scripts/build-backend.cjs && node scripts/build-preview.cjs",
    "check": "node scripts/check-project.cjs",
    "test": "node scripts/test-project.cjs",
    "test:browser": "python scripts/check-browser.py",
    "build:pages": "npm run build && node scripts/build-pages.cjs",
    "test:backend": "node scripts/check-backend.cjs",
    "catalogue:download": "node scripts/catalogue-import.cjs download",
    "catalogue:import:local": "node scripts/catalogue-import.cjs --local",
    "catalogue:download:english": "node scripts/catalogue-import.cjs download --all-english",
    "catalogue:import:english:local": "node scripts/catalogue-import.cjs --local --all-english",
    "test:catalogue:full": "node scripts/check-catalogue-full.cjs",
    "test:catalogue": "node scripts/check-catalogue.cjs",
    "test:repository": "node scripts/check-repository.cjs && node scripts/check-collection-repository.cjs",
    "backend:start": "node scripts/backend-local.cjs start",
    "backend:stop": "node scripts/backend-local.cjs stop",
    "backend:status": "node scripts/backend-local.cjs status",
    "test:backend:live": "node scripts/check-backend-live.cjs",
    "test:backend:browser": "node scripts/check-backend-live.cjs --browser",
    "test:account-backup": "node scripts/check-backup-crypto.cjs && node scripts/check-account-backup.cjs",
    "backend:backup": "node scripts/backend-ops.cjs backup",
    "backend:recover": "node scripts/backend-ops.cjs recover",
    "backend:health": "node scripts/backend-ops.cjs health",
    "backend:backup:auto": "node scripts/backend-backup-auto.cjs",
    "test:backup:auto": "node scripts/check-backup-automation.cjs && node scripts/check-backup-r2.cjs && node scripts/check-backup-supabase.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "supabase": "2.121.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
