# Copy this to .env.local. Never commit the filled file.
# Local Google OAuth app (backend only; never included in the website).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Leave these blank until the local stack runs. Get local values from
# npm run backend:status, then set them to enable cloud mode in local builds.
POKEDEX_SUPABASE_URL=
POKEDEX_SUPABASE_PUBLISHABLE_KEY=
# Enable only after the usage gateway and its database gate are configured.
POKEDEX_USAGE_GATEWAY=false

# Operator only. Private values must never enter browser code or Git.
# These can instead be supplied as protected GitHub backup-production secrets.
POKEDEX_BACKUP_URL=
POKEDEX_BACKUP_SECRET_KEY=
POKEDEX_BACKUP_PASSPHRASE=
SUPABASE_ACCESS_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
HEALTHCHECKS_PING_URL=
